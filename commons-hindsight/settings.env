# Hindsight — LLM provider for fact extraction, entity resolution, and reflect.
#
# Everything else runs locally: the embedder, the reranker, and the embedded
# PostgreSQL are all inside the container. Only the LLM calls in this file go
# off-box, and they carry memory content to your provider.
#
# Edit this file after install, then restart the app from the Umbrel dashboard.
# Any key present here is stored in plain text in this app's data directory.

HINDSIGHT_API_LLM_API_KEY=replace-me

# Already set in docker-compose.yml; shown here so all LLM config is in one
# place. provider "openai" + BASE_URL covers every OpenAI-compatible endpoint.
# HINDSIGHT_API_LLM_PROVIDER=openai
# HINDSIGHT_API_LLM_BASE_URL=https://openrouter.ai/api/v1
# HINDSIGHT_API_LLM_MODEL=stealth/space-bunny-alpha

# --- Other providers ---
# Anthropic directly:
# HINDSIGHT_API_LLM_PROVIDER=anthropic
# HINDSIGHT_API_LLM_API_KEY=sk-ant-...
#
# Groq:
# HINDSIGHT_API_LLM_PROVIDER=groq
#
# Fully local via llama.cpp — auto-downloads a ~3.5 GB Gemma GGUF. Not
# available in the Docker image; run llama.cpp or Ollama separately and point
# HINDSIGHT_API_LLM_BASE_URL at it.