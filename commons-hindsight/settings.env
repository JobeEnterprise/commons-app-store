# Hindsight — required secrets and optional provider overrides.
#
# umbrelOS has no key-entry form, so edit this file after install and restart
# the app from the dashboard. Everything here is stored in plain text in this
# app's data directory.
#
# Generate the two keys below, e.g.:  openssl rand -hex 32

# --- Required: API authentication ---
# The API on port 8888 listens on 0.0.0.0 inside the container. Umbrel's proxy
# gates only the web UI, so without this key anything able to reach the
# container can read and write your memories. Sent as `Authorization: Bearer`.
HINDSIGHT_API_KEY=replace-me-with-a-random-string

# --- Required: web UI login ---
# Separate gate for the Control Plane UI in your Umbrel dashboard. You will be
# asked for this when you open the app.
HINDSIGHT_CP_KEY=replace-me-with-a-different-random-string

# --- Required: LLM provider ---
# Used for fact extraction, entity resolution, and reflect. These calls are the
# only ones that leave the device, and they carry memory content to the provider.
# OpenRouter is already configured in docker-compose.yml.
HINDSIGHT_API_LLM_API_KEY=replace-me

# --- Optional: other LLM providers ---
# Anthropic directly:
# HINDSIGHT_API_LLM_PROVIDER=anthropic
# HINDSIGHT_API_LLM_API_KEY=sk-ant-...
#
# Groq:
# HINDSIGHT_API_LLM_PROVIDER=groq
#
# Fully local via llama.cpp or Ollama — run one alongside and point
# HINDSIGHT_API_LLM_BASE_URL at it. Note the built-in llama.cpp provider is not
# available in the Docker image.

# --- Optional: multilingual content ---
# The default embedder (BAAI/bge-small-en-v1.5) is English-only. Non-English
# content ingests fine but semantic recall degrades. Switching the embedding
# model requires re-embedding existing memories.
# HINDSIGHT_API_EMBEDDINGS_PROVIDER=openrouter
# HINDSIGHT_API_EMBEDDINGS_API_KEY=replace-me
# HINDSIGHT_API_EMBEDDINGS_MODEL=openai/text-embedding-3-small