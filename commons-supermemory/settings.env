# Supermemory — LLM provider for memory extraction, contextual chunking, and
# summaries. Embeddings are NOT configured here: they default to a local ONNX
# model (Xenova/bge-base-en-v1.5, 768d) that runs inside the container with no
# API key and nothing leaving the device.
#
# Edit this file after install, then restart the app from the Umbrel dashboard.
# Any key present here is stored in plain text in this app's data directory.

# --- OpenRouter (OpenAI-compatible) ---
OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=stealth/space-bunny-alpha

# --- Alternatives ---
# Fully offline via Ollama (Ollama must already be running and reachable):
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# OPENAI_MODEL=gpt-oss:20b
#
# Image, video, and high-fidelity PDF understanding require Gemini or Vertex:
# GEMINI_API_KEY=replace-me
#
# Multilingual content (the default local embedding model is English-only):
# SUPERMEMORY_EMBEDDING_PROVIDER=openai
# SUPERMEMORY_EMBEDDING_MODEL=text-embedding-3-small
# SUPERMEMORY_EMBEDDING_DIMENSIONS=1536
# WARNING: dimensions must match the model AND any already-stored vectors.
# Changing them after ingesting data makes existing vectors unreadable.